{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Distance-accurate exoplanet visualization with AI-constrained surface generation",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @aether/web run dev",
    "build": "pnpm run build:packages && pnpm run build:web",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "build:web": "pnpm --filter @aether/web run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
