{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Distance-accurate exoplanet visualization with AI-constrained surface generation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @aether/web run dev",
    "lint": "pnpm -r run lint",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
