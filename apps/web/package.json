{
  "name": "@aether/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Three.js client \u2014 multi-scale precision spike",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:browser": "node e2e/smoke.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aether/catalog": "workspace:*",
    "@aether/coordinates": "workspace:*",
    "@aether/deepsky": "workspace:*",
    "@aether/exoplanets": "workspace:*",
    "@aether/missions": "workspace:*",
    "@aether/physics": "workspace:*",
    "@aether/schema": "workspace:*",
    "@aether/solar-system": "workspace:*",
    "@aether/stars": "workspace:*",
    "@aether/terrain": "workspace:*",
    "@aether/units": "workspace:*",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "jsdom": "^26.1.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
