{
  "name": "@aether/deepsky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deep-sky catalogue (OpenNGC) with derived distances and honest cosmology",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./data/*": "./data/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "build:catalog": "node scripts/build-catalog.mjs"
  },
  "dependencies": {
    "@aether/units": "workspace:*"
  }
}
