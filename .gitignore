# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
.vite/
coverage/

# Secrets and local config — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Python virtual environments (the ML and ingestion side)
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Data and model artifacts live in object storage or DVC, never in git
data/snapshots/
*.parquet
*.pkl
*.onnx
*.h5
*.npz

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Generated by `pnpm --filter @aether/solar-system run export:cards`.
# Reproducible from the body tables, so it is built rather than committed.
solar-system-cards.json

# Vendored Python tool. Not part of the pnpm workspace.
tools/aether-harness/**/__pycache__/
tools/aether-harness/solar-out/
tools/aether-harness/*.ledger.json

# Local API key staged for the harness. Never commit.
tools/aether-harness/.opencode.key

# Local API key staged for the harness. Never commit.
tools/aether-harness/.opencode.key
tools/aether-harness/*.ledger.json
tools/aether-harness/specs/
tools/aether-harness/one-card.json
tools/aether-harness/*-out/

# TRAPPIST card export is regenerable.
packages/catalog/trappist-cards.json
tools/aether-harness/trappist4.json
