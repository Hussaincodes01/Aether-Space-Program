# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── Data sources ────────────────────────────────────────────────────────────────────────
# The NASA Exoplanet Archive TAP service needs no key, but a contact string is polite and
# helps the archive team diagnose heavy queries.
NASA_ARCHIVE_USER_AGENT="aether/0.1 (contact@example.com)"

# NASA Planetary Spectrum Generator. Cache aggressively and rate-limit; the public API is
# not a batch-compute service. Leave blank to use the public endpoint.
PSG_API_URL="https://psg.gsfc.nasa.gov/api.php"
PSG_API_KEY=""

# ── Backend (P1 onward) ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://aether:aether@localhost:5432/aether"
REDIS_URL="redis://localhost:6379"
OBJECT_STORE_ENDPOINT="http://localhost:9000"
OBJECT_STORE_ACCESS_KEY=""
OBJECT_STORE_SECRET_KEY=""

# ── AI surface composer (P3 onward) ─────────────────────────────────────────────────────
# The composer runs offline in batch and its output is cached and content-addressed.
# It is never called at render time. See docs/PRD.md section 9.4.
#
# Provider and model are not yet chosen — that is a week-1 decision (PRD section 18.6),
# and whichever is picked gets pinned into model_versions so a world composed by a
# different model is recorded as a different world.
COMPOSER_PROVIDER=""
COMPOSER_API_KEY=""
COMPOSER_MODEL=""
